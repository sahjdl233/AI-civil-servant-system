# 复制为 .env 并按需填写（.env 已被 gitignore，切勿提交真实密钥）
# AI Provider 默认配置（用于空库时的种子 Provider）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# 数据库（Postgres 默认；SQLite 可留空或使用 sqlite:///./dev.db）
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/zhikao_db

# 用于加密 ai_providers.api_key 的密钥（必填，建议随机生成 32+ 位）
SECRET_KEY=please-generate-a-long-random-secret

DEBUG=False

# 评分可信度（同一作文连续评分 N 次）
# CREDIBILITY_ROUNDS=3
# CREDIBILITY_CONCURRENCY=1
# CREDIBILITY_RANGE_PENALTY=5.0
# CREDIBILITY_STAR_THRESHOLDS=85,70,55,35
